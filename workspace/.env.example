# 행사 전에 반드시 변경하세요. 실제 값은 Git에 커밋하지 않습니다.
EVENT_CODE=change-this-event-code
N8N_API_KEY=change-this-n8n-key
ADMIN_KEY=change-this-admin-key
SESSION_SECRET=change-this-session-secret-at-least-32-characters

PORT=3000
DATA_DIR=/data
MAX_UPLOAD_MB=30
SESSION_HOURS=12

# ONLYOFFICE 컨테이너를 함께 실행할 때 true로 둡니다.
ONLYOFFICE_ENABLED=true
ONLYOFFICE_JWT_SECRET=change-this-onlyoffice-jwt-secret
# Docker Compose가 설정하므로 일반적으로 변경하지 않습니다.
ONLYOFFICE_APP_INTERNAL_ORIGIN=http://caddy:8080
ONLYOFFICE_SERVER_INTERNAL_ORIGIN=http://onlyoffice
